# Copy this file to ".env" and edit as needed.

# Free key from https://finnhub.io (Dashboard -> API key).
# Leave empty to run in DEMO mode with simulated live prices.
FINNHUB_API_KEY=

# auto = live data if a key is set, otherwise demo. Other options: demo, finnhub
DATA_MODE=auto

# Behavioural risk engine
COOLDOWN_SECONDS=300
DAILY_TRADE_LIMIT=10
MAX_CONSECUTIVE_LOSSES=3

# Paper trading
STARTING_CASH=100000

# Watchlist shown in the dashboard (comma separated)
TICKERS=AAPL,TSLA,MSFT,NVDA,AMZN,GOOGL
